{
  "name": "orbit-browser",
  "version": "2.0.0",
  "description": "Orbit Browser - a custom desktop web browser built on Electron (real Chromium engine)",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:nosandbox": "electron . --no-sandbox",
    "test": "node scripts/test.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.orbit.browser",
    "productName": "Orbit Browser",
    "files": ["src/**/*", "package.json"],
    "win": {"target": "nsis"},
    "mac": {"target": "dmg"},
    "linux": {"target": ["AppImage", "deb"]}
  }
}
